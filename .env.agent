# .env.agent — copy to .env on the MongoDB machine and fill in SERVER_HOST
#
# Required
SERVER_HOST=marvel-3a78bd953f5f.herokuapp.com

# Optional — the in-house OIDC IdP. When set, ./run-agent.sh start
# also brings up the wsdbagent-idp container, which connects to the
# idp Heroku app (Phase H/I; design Q1: same image to both apps,
# shared InnerTLS CA, one cert family). Leave unset (or comment out)
# to run a marvel-only on-prem stack.
IDP_SERVER_HOST=idp-63c97365e6ef.herokuapp.com
# IDP_SERVER_PORT=443
# IDP_TLS_HOSTNAME=idp.xpmile.com

# Optional — override defaults
# SERVER_PORT=443
# MONGO_ROOT_USER=root
# MONGO_ROOT_PASS=changeme
# MONGO_APP_USER=xpmile
# MONGO_APP_PASS=xpmile_pass
# MONGO_DB=xpmile
# MONGO_POOL=10
# BACKOFF=5

# Pin the mongo image version. Defaults to 7. Override to 4.4 on
# Raspberry Pi 3B / other Cortex-A53 (armv8.0-A) hosts — mongo:5+
# requires armv8.2-A on arm64 and won't start. Data files are
# compatible 4.4 → 7; only the runtime binary differs. See
# docs/operator-pi3b.md.
# MONGO_VERSION=4.4

# Inner TLS hostname verification (CN/SAN to expect from the server cert)
# Leave empty to skip CN verification (CA chain is still verified)
# TLS_HOSTNAME=marvel.xpmile.com

# Inner TLS cert dir on host — written by `./run-agent.sh refresh-certs`.
# Defaults to ./certs/cloud-issued/innertls/ (the dir the
# xpmile-cert-watcher sidecar watches).  Override only if you keep
# the rotated certs somewhere else.
# CERTS_DIR=./certs/cloud-issued/innertls

# cert-watcher tuning. The sidecar auto-detects which engine is on the
# other end of the socket (libpod /v4.0.0/libpod/_ping vs docker /_ping)
# and picks the matching restart URL template — so the same compose file
# works on both rootful podman, rootless podman, and dockerd.
# CERT_WATCH_POLL_SECONDS=5
# PODMAN_SOCKET=/run/podman/podman.sock                  # rootful podman (default)
# PODMAN_SOCKET=${XDG_RUNTIME_DIR}/podman/podman.sock    # rootless podman
# PODMAN_SOCKET=/var/run/docker.sock                     # docker (Pi 3B with Docker installed)

# wsdbagent image pin — defaults to docker.io/naushada/xpmile-wsdbagent:latest
# (auto-pulled by `./run-agent.sh start` because compose has
# pull_policy: always).  Pin to a specific deploy by setting:
# WSDBAGENT_IMAGE=docker.io/naushada/xpmile-wsdbagent:<sha>
