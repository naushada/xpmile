# .env.agent — copy to .env on the MongoDB machine and fill in SERVER_HOST
#
# Required
SERVER_HOST=marvel.herokuapp.com

# Optional — override defaults
# SERVER_PORT=443
# MONGO_ROOT_USER=root
# MONGO_ROOT_PASS=changeme
# MONGO_APP_USER=xpmile
# MONGO_APP_PASS=xpmile_pass
# MONGO_DB=xpmile
# MONGO_POOL=10
# BACKOFF=5

# Inner TLS hostname verification (CN/SAN to expect from the server cert)
# Leave empty to skip CN verification (CA chain is still verified)
# TLS_HOSTNAME=marvel.xpmile.com

# Inner TLS cert dir on host — written by `./run-agent.sh refresh-certs`.
# Defaults to ./certs/cloud-issued/innertls/ (the dir the
# xpmile-cert-watcher sidecar watches).  Override only if you keep
# the rotated certs somewhere else.
# CERTS_DIR=./certs/cloud-issued/innertls

# cert-watcher tuning
# CERT_WATCH_POLL_SECONDS=5
# PODMAN_SOCKET=/run/podman/podman.sock                  # rootful (default)
# PODMAN_SOCKET=${XDG_RUNTIME_DIR}/podman/podman.sock    # rootless
