# docker/Dockerfile.test — offtarget GTest image for xpmile.
#
# Builds the offtarget test binary against the shared C++ toolchain
# (ACE/TAO + mongo-cxx + gtest, pre-built in xpmile-cpp-builder:bootstrap),
# then `docker run` invokes the binary as a one-shot CI quality gate.
# Failed tests OR a compile error stop the publish + Heroku release.
#
# BUILDER_IMAGE override: same three-context rationale as
# docker/Dockerfile. Local dev keeps the localhost/ default; CI
# overrides to docker.io/naushada/xpmile-cpp-builder:bootstrap.
ARG BUILDER_IMAGE=localhost/xpmile-cpp-builder:bootstrap
FROM ${BUILDER_IMAGE}

# Phase E (SAML) XML-DSig needs an XML library. These are apt packages, not
# compiled-from-source, so they install in seconds with no bootstrap rebuild.
# -o Acquire::Check-Date=false tolerates build-host clock skew (the repo
# Release files still read as "not valid yet" otherwise). Packages stay
# GPG- and hash-verified; only the Release-file freshness check is relaxed.
RUN apt-get -o Acquire::Check-Date=false update \
 && apt-get install -y --no-install-recommends \
        pkg-config libxml2-dev libxmlsec1-dev libxmlsec1-openssl \
 && rm -rf /var/lib/apt/lists/*

WORKDIR /src
COPY CMakeLists.txt /src/
COPY modules/      /src/modules/
COPY test/         /src/test/
# SeedDataTest.BootstrapAdminHasHashedPassword reads
# /src/docker/mongo-init.js to verify the seeded admin uses a
# passwordHash (not plain-text accountPassword). Ship the file with
# the image; without it the test ASSERTs on the missing file.
COPY docker/mongo-init.js /src/docker/mongo-init.js
# innertls_test reads server.crt/server.key + client.crt/key from
# /src/certs/. The *.key files are gitignored (see certs/.gitignore),
# so a plain `COPY certs/` leaves the keys missing in CI and the 8
# InnerTlsTests skip with GTEST_SKIP. Generate a fresh self-signed
# CA + server + client triple inline instead — the tests only need
# a working keypair set; the CA's identity doesn't matter for the
# in-memory handshake. Mirrors certs/generate.sh.
RUN mkdir -p /src/certs && cd /src/certs \
 && openssl genrsa -out ca.key 2048 \
 && openssl req -new -x509 -days 365 -key ca.key -out ca.crt \
        -subj "/O=xpmile-test/CN=xpmile-test-CA" \
 && openssl genrsa -out server.key 2048 \
 && openssl req -new -key server.key -out server.csr \
        -subj "/O=xpmile-test/CN=uniservice" \
 && openssl x509 -req -days 365 -in server.csr \
        -CA ca.crt -CAkey ca.key -CAcreateserial -out server.crt \
 && openssl genrsa -out client.key 2048 \
 && openssl req -new -key client.key -out client.csr \
        -subj "/O=xpmile-test/CN=wsdbagent" \
 && openssl x509 -req -days 365 -in client.csr \
        -CA ca.crt -CAkey ca.key -CAcreateserial -out client.crt \
 && rm -f server.csr client.csr ca.srl

WORKDIR /src/build
RUN cmake -DBUILD_TESTS=ON -DCMAKE_CXX_FLAGS="-fconcepts" .. \
 && make -j2 offtarget xpmile-pull

WORKDIR /src/build/test
# Three tests depend on a live MongoDB (no Mongo fixture in CI yet),
# excluded by the gtest_filter below. Wire up a Mongo sidecar to the
# `test` job in .github/workflows/publish-images.yml to include them.
CMD ["./offtarget", "--gtest_color=yes", \
     "--gtest_filter=-AccountLoginTest.ValidCredentials_Returns200WithAccountData:AccountLoginTest.ResponseBody_ExcludesSensitiveFields:WsDbServer.SecondAgentRejected_When_FirstAlive"]
