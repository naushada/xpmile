# ── Global build ARGs ────────────────────────────────────────────────
# BuildKit scopes ARGs declared AFTER a FROM to that stage only — they
# become invisible to subsequent FROM lines. Both ARGs we use across
# multiple stages MUST be declared up here, BEFORE any FROM. Without
# this, BuildKit fails with `base name (${BUILDER_IMAGE}) should not be
# blank` because BUILDER_IMAGE is undefined in the cpp-builder FROM if
# it was declared inside the previous stage's scope.
ARG BUILDER_IMAGE=localhost/xpmile-cpp-builder:bootstrap
ARG UNISERVICE_REF=docker.io/naushada/xpmile-uniservice:latest

# ============================================================
# Stage 0: Pull the freshly-minted InnerTLS cert family from this
#          workflow's just-built uniservice image.
# ============================================================
# docker/Dockerfile (uniservice) mints a brand-new InnerTLS CA, server
# cert, AND matching client cert family on every build (PR #8). The
# CLOUD-side image bakes in the CA + server cert. The AGENT-side image
# (this one) bakes in the CLIENT cert family — same CA, signed in the
# same build — so the operator never has to pull uniservice on the
# agent host just to extract certs. ./run-agent.sh refresh-certs and
# install-agent.sh both extract from THIS image (~10 MB pull) instead
# of uniservice (~500 MB).
#
# UNISERVICE_REF MUST be the per-sha tag of the SAME workflow run that
# produced the matching CA + server cert — `latest` is wrong because
# it can lag if uniservice CI fails mid-rollout. The CI workflow
# passes `${UNISERVICE_IMAGE}:${{ github.sha }}` here.
FROM ${UNISERVICE_REF} AS uniservice-source

# ============================================================
# Stage 1: Build wsdbagent (shares toolchain with main Dockerfile)
# ============================================================
# BUILDER_IMAGE: see docker/Dockerfile for the three-context rationale.
FROM ${BUILDER_IMAGE} AS cpp-builder

# The root CMakeLists.txt does pkg_check_modules(XMLSEC REQUIRED ...) for the
# SSO module's SAML XML-DSig. cmake resolves every find/pkg_check at configure
# time regardless of which target is built — so even a `wsdbagent`-only build
# (which never links xmlsec1) fails at `cmake ..` unless the dev packages are
# present. apt packages, not compiled-from-source, so no bootstrap rebuild is
# required. -o Acquire::Check-Date=false tolerates build-host clock skew.
RUN apt-get -o Acquire::Check-Date=false update \
 && apt-get install -y --no-install-recommends \
        pkg-config libxml2-dev libxmlsec1-dev libxmlsec1-openssl \
 && rm -rf /var/lib/apt/lists/*

# Build wsdbagent
COPY CMakeLists.txt /src/
COPY modules/ /src/modules/
COPY test/ /src/test/
WORKDIR /src/build
RUN cmake .. -DCMAKE_CXX_FLAGS="-fconcepts" -DBUILD_TESTS=OFF && make -j2 wsdbagent

# ============================================================
# Stage 2: Minimal runtime image
# ============================================================
FROM docker.io/library/ubuntu:focal AS runtime

ENV TZ=Asia/Calcutta DEBIAN_FRONTEND=noninteractive
RUN ln -snf /usr/share/zoneinfo/$TZ /etc/localtime && echo $TZ > /etc/timezone

RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates \
    libssl1.1 \
    libboost-filesystem1.71.0 \
    libboost-system1.71.0 \
    libboost-thread1.71.0 \
    libzstd1 \
    libsasl2-2 \
    zlib1g \
    libicu66 \
    && rm -rf /var/lib/apt/lists/*

# ACE/TAO shared libraries
COPY --from=cpp-builder /usr/local/ACE_TAO-7.0.0/lib/ /usr/local/ACE_TAO-7.0.0/lib/
RUN echo "/usr/local/ACE_TAO-7.0.0/lib" > /etc/ld.so.conf.d/ace-tao.conf

# MongoDB C/C++ driver shared libraries
COPY --from=cpp-builder /usr/local/lib/libmongoc-1.0.so* /usr/local/lib/
COPY --from=cpp-builder /usr/local/lib/libbson-1.0.so* /usr/local/lib/
COPY --from=cpp-builder /usr/local/lib/libmongocxx.so* /usr/local/lib/
COPY --from=cpp-builder /usr/local/lib/libbsoncxx.so* /usr/local/lib/

RUN ldconfig

RUN mkdir -p /opt/wsdbagent
COPY --from=cpp-builder /src/build/wsdbagent /opt/wsdbagent/wsdbagent

# Bake the matching cert family from this workflow run's uniservice.
# Operator-side `./run-agent.sh refresh-certs` and `install-agent.sh`
# pull THIS image (~10 MB cumulative on top of the agent binary they
# already need) and `podman cp /opt/wsdbagent/baked-certs/.` into their
# host-side ./certs/cloud-issued/innertls/. The wsdbagent runtime itself
# still reads from --tls-ca /certs/ca.crt (bind-mounted) so existing
# operator deployments need NO change to the running container.
COPY --from=uniservice-source /opt/xAPP/granada/agent-certs/ /opt/wsdbagent/baked-certs/

WORKDIR /opt/wsdbagent

# Required: --server-host, --mongo-db-uri, --mongo-db-name
# Optional: --server-port (default: 443, TLS mandatory), --mongo-db-connection-pool, --backoff
ENV ARGS=""

CMD /opt/wsdbagent/wsdbagent ${ARGS}
