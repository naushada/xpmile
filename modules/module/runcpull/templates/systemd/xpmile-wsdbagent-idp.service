[Unit]
Description=xpmile wsdbagent — idp (runc)
After=xpmile-mongo.service
Requires=xpmile-mongo.service

[Service]
Type=simple
ExecStartPre=-/usr/bin/runc delete --force xpmile-wsdbagent-idp
ExecStart=/usr/bin/runc run --bundle __INSTALL_DIR__/bundles/wsdbagent-idp xpmile-wsdbagent-idp
ExecStop=/usr/bin/runc kill xpmile-wsdbagent-idp SIGTERM
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
